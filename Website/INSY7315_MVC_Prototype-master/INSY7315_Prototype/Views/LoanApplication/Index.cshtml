@{
    ViewData["Title"] = "Loan Application";
}

<div class="application-page">

    <!-- Page Header -->

    <div class="application-header">

        <span class="application-label">BRIDGE&ANCHOR</span>

        <h1>Loan Application</h1>

        <p>
            Ready to apply for a loan? Download the application form
            below and complete the required information.
        </p>

    </div>


    <!-- Application Information -->

    <div class="application-info">

        <div class="info-content">

            <div class="info-icon">
                01
            </div>

            <div>

                <h2>Before You Start</h2>

                <p>
                    The loan application requires personal, residential,
                    employment, banking and loan information. You may also
                    need to provide information about your spouse or partner
                    and relatives where applicable.
                </p>

                <p>
                    Please make sure you have the relevant information
                    available before completing the application form.
                    Take your time and check that all information is
                    accurate and complete.
                </p>

            </div>

        </div>


        <div class="info-list">

            <div class="info-item">
                <span>✓</span>
                <p>Complete all applicable sections.</p>
            </div>

            <div class="info-item">
                <span>✓</span>
                <p>Provide accurate personal information.</p>
            </div>

            <div class="info-item">
                <span>✓</span>
                <p>Have your employment and banking information available.</p>
            </div>

            <div class="info-item">
                <span>✓</span>
                <p>Include the amount and reason for your loan.</p>
            </div>

        </div>

    </div>


    <!-- Download Form -->

    <div class="download-card">

        <div class="download-icon">
            ↓
        </div>

        <div class="download-content">

            <span>OFFICIAL APPLICATION FORM</span>

            <h2>Download the Loan Application</h2>

            <p>
                Download the official Bridge&Anchor loan application form.
                Once completed, please follow the instructions provided
                by Bridge&Anchor for submitting your application.
            </p>

        </div>

        <a href="~/documents/BridgeAnchor_Loan_Application_Fillable.pdf"
           download
           class="download-button">

            Download Form

        </a>

    </div>


    <!-- Help / Contact -->

    <div class="application-help">

        <div class="help-icon">
            ?
        </div>

        <div class="help-content">

            <h2>Need Help With Your Application?</h2>

            <p>
                If you have any questions or experience any problems
                while completing the application form, please contact
                Bridge&Anchor for assistance.
            </p>


            <div class="contact-options">

                <div>
                    <strong>Phone</strong>
                    <span>032 586 0200</span>
                </div>

                <div>
                    <strong>Mobile</strong>
                    <span>072 793 1178</span>
                </div>

                <div>
                    <strong>Mobile</strong>
                    <span>082 265 0045</span>
                </div>

                <div>
                    <strong>Email</strong>
                    <a href="mailto:info@bridgeanchor.co.za">
                        info@bridgeanchor.co.za
                    </a>
                </div>

            </div>

        </div>

    </div>


    <!-- Notice -->

    <div class="application-notice">

        <strong>Please Note</strong>

        <p>
            Completing the application form does not guarantee that
            a loan will be approved. All applications are subject to
            the Bridge&Anchor assessment process.
        </p>

    </div>

</div>