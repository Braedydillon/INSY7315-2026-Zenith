@{
    ViewData["Title"] = "Loan Application";
}

<div class="application-page">

    <!-- Page Header -->
    <div class="application-header">
        <span class="application-label">BRIDGE & ANCHOR</span>
        <h1>Loan Application</h1>
        <p>
            Ready to apply for a loan? Review the information
            and supporting documents required before starting
            your online application.
        </p>
    </div>

    <!-- Application Information -->
    <div class="application-info">
        <div class="info-content">
            <div class="info-icon">01</div>

            <div>
                <h2>Before You Start</h2>
                <p>
                    Our application process requires personal,
                    residential, employment, income, banking
                    and loan information.
                </p>
                <p>
                    Please ensure that all information you provide
                    is accurate and up to date. Applications are
                    subject to verification and an affordability
                    assessment.
                </p>
            </div>
        </div>

        <div class="info-list">
            <div class="info-item">
                <span>✓</span>
                <p>Have your South African ID or accepted identification ready.</p>
            </div>

            <div class="info-item">
                <span>✓</span>
                <p>Prepare your employment and income information.</p>
            </div>

            <div class="info-item">
                <span>✓</span>
                <p>Have your banking details and monthly expenses available.</p>
            </div>

            <div class="info-item">
                <span>✓</span>
                <p>Decide on your requested loan amount and repayment period.</p>
            </div>
        </div>
    </div>

    <!-- Supporting Documents -->
    <div class="application-info">
        <div class="info-content">
            <div class="info-icon">02</div>

            <div>
                <h2>Supporting Documents</h2>
                <p>
                    You may be asked to provide the following
                    documents to support your application.
                    Requirements may vary depending on your
                    employment and financial circumstances.
                </p>
            </div>
        </div>

        <div class="info-list">
            <div class="info-item">
                <span>✓</span>
                <p>
                    <strong>Proof of Identity:</strong>
                    A clear copy of your ID document or accepted identification.
                </p>
            </div>

            <div class="info-item">
                <span>✓</span>
                <p>
                    <strong>Bank Statements:</strong>
                    Recent bank statements, generally covering
                    the last three months where applicable.
                </p>
            </div>

            <div class="info-item">
                <span>✓</span>
                <p>
                    <strong>Proof of Income:</strong>
                    Recent payslips or other acceptable income
                    evidence, depending on your circumstances.
                </p>
            </div>

            <div class="info-item">
                <span>✓</span>
                <p>
                    <strong>Proof of Address:</strong>
                    A recent utility bill, bank statement or
                    other accepted document showing your address,
                    where address verification is required.
                </p>
            </div>
        </div>

        <p class="mt-3 text-muted">
            Note: A bank statement may also serve as proof of
            address if it displays your name, residential address
            and meets the verification requirements.
            Additional documents may be requested during review.
        </p>
    </div>

    <!-- Online Application -->
    <div class="apply-card">
        <div class="apply-icon">→</div>

        <div class="apply-body">
            <span class="apply-eyebrow">ONLINE APPLICATION</span>
            <h3 class="apply-title">Apply for a Loan</h3>

            <p>
                Complete your loan application online.
                You will need to sign in or create an account
                before submitting your application.
            </p>

            <a asp-controller="Loan"
               asp-action="Apply"
               class="apply-btn">
                Start Application →
            </a>

            <p class="apply-hint">
                Already registered? Sign in to continue.
            </p>
        </div>
    </div>

    <!-- Download Form -->
    <div class="download-card">
        <div class="download-icon">↓</div>

        <div class="download-content">
            <span>APPLICATION FORM</span>
            <h2>Prefer a Paper Application?</h2>

            <p>
                Download the Bridge & Anchor loan application
                form if you prefer to complete it manually.
                Contact our team for submission instructions.
            </p>
        </div>

        <a href="~/documents/BridgeAnchor_Loan_Application_Fillable.pdf"
           download
           class="download-button btn-shadow">
            Download Form
        </a>
    </div>

    <!-- Help / Contact -->
    <div class="application-help">
        <div class="help-icon">?</div>

        <div class="help-content">
            <h2>Need Help With Your Application?</h2>

            <p>
                If you have questions about the application
                process or supporting documents, our team
                is available to assist.
            </p>

            <div class="contact-options">
                <div>
                    <strong>Phone</strong>
                    <span>032 586 0200</span>
                </div>

                <div>
                    <strong>Mobile</strong>
                    <span>072 793 1178</span>
                </div>

                <div>
                    <strong>Mobile</strong>
                    <span>082 265 0045</span>
                </div>

                <div>
                    <strong>Email</strong>
                    <a href="mailto:info@bridgeanchor.co.za">
                        info@bridgeanchor.co.za
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Notice -->
    <div class="application-notice">
        <strong>Please Note</strong>
        <p>
            Completing an application does not guarantee loan
            approval. All applications are subject to identity
            verification, affordability assessment and the
            Bridge & Anchor review process.
        </p>
    </div>

</div>
