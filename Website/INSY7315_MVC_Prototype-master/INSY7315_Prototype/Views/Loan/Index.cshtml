@{
    ViewData["Title"] = "My Loans";
}

<div class="loans-page">

    <div class="loans-header">
        <div>
            <h1>My Loans</h1>
            <p>View and track your loan applications.</p>
        </div>

        <a href="#" class="apply-button">
            Apply for a Loan
        </a>
    </div>

    <div class="loan-summary">

        <div class="summary-card">
            <span>Total Applications</span>
            <strong>3</strong>
        </div>

        <div class="summary-card">
            <span>Pending</span>
            <strong>1</strong>
        </div>

        <div class="summary-card">
            <span>Approved</span>
            <strong>1</strong>
        </div>

        <div class="summary-card">
            <span>Total Requested</span>
            <strong>R85,000</strong>
        </div>

    </div>

    <div class="loans-card">

        <div class="card-header">
            <h2>Loan Applications</h2>
        </div>

        <div class="loan-list">

            <div class="loan-item">

                <div class="loan-info">
                    <h3>Personal Loan</h3>
                    <p>Application #LN-001</p>
                </div>

                <div class="loan-detail">
                    <span>Amount</span>
                    <strong>R25,000</strong>
                </div>

                <div class="loan-detail">
                    <span>Date Applied</span>
                    <strong>12 Aug 2026</strong>
                </div>

                <div class="loan-detail">
                    <span>Term</span>
                    <strong>24 Months</strong>
                </div>

                <span class="status pending">
                    Pending
                </span>

            </div>


            <div class="loan-item">

                <div class="loan-info">
                    <h3>Home Improvement Loan</h3>
                    <p>Application #LN-002</p>
                </div>

                <div class="loan-detail">
                    <span>Amount</span>
                    <strong>R50,000</strong>
                </div>

                <div class="loan-detail">
                    <span>Date Applied</span>
                    <strong>03 Aug 2026</strong>
                </div>

                <div class="loan-detail">
                    <span>Term</span>
                    <strong>36 Months</strong>
                </div>

                <span class="status approved">
                    Approved
                </span>

            </div>


            <div class="loan-item">

                <div class="loan-info">
                    <h3>Emergency Loan</h3>
                    <p>Application #LN-003</p>
                </div>

                <div class="loan-detail">
                    <span>Amount</span>
                    <strong>R10,000</strong>
                </div>

                <div class="loan-detail">
                    <span>Date Applied</span>
                    <strong>20 Jul 2026</strong>
                </div>

                <div class="loan-detail">
                    <span>Term</span>
                    <strong>12 Months</strong>
                </div>

                <span class="status declined">
                    Declined
                </span>

            </div>

        </div>

    </div>

</div>
