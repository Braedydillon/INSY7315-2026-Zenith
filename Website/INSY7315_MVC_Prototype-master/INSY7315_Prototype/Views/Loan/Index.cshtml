@model INSY7315_Prototype.ViewModels.MyLoansViewModel
@{
    ViewData["Title"] = "My Loans";
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="fw-bold">My Loans</h1>
        <p class="text-muted">View and track your loan applications.</p>
    </div>
    <a asp-action="Apply" class="btn btn-primary">Apply for a Loan</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3 mb-4">
    @foreach (var (label, value) in new[] {
        ("Total Applications", Model.Total.ToString()),
        ("Pending", Model.Pending.ToString()),
        ("Approved", Model.Approved.ToString()),
        ("Total Requested", "R" + Model.TotalRequested.ToString("N0")) })
    {
        <div class="col-md-3">
            <div class="card p-4 h-100">
                <div class="text-muted">@label</div>
                <div class="fs-3 fw-bold">@value</div>
            </div>
        </div>
    }
</div>

<div class="card">
    <div class="card-header bg-light fs-5 p-4">Loan Applications</div>

    @foreach (var l in Model.Loans.OrderByDescending(x => x.ApplicantFormDate))
    {
        var badge = l.Status?.ToLower() switch
        {
            "approved" => "bg-success-subtle text-success",
            "declined" or "rejected" => "bg-danger-subtle text-danger",
            _ => "bg-warning-subtle text-warning-emphasis"
        };

        <div class="row align-items-center p-4 border-bottom mx-0">
            <div class="col-md-3">
                <div class="fw-semibold">@(l.ReasonForLoan ?? "Loan")</div>
                <small class="text-muted">Application #@l.Id</small>
            </div>
            <div class="col-md-3">
                <small class="text-muted d-block">Amount</small>
                <strong>R@l.RequestedAmount.ToString("N0")</strong>
            </div>
            <div class="col-md-4">
                <small class="text-muted d-block">Date Applied</small>
                <strong>@l.ApplicantFormDate.ToString("dd MMM yyyy")</strong>
            </div>
            <div class="col-md-2 text-end">
                <span class="badge rounded-pill px-3 py-2 @badge">@l.Status</span>
            </div>
        </div>
    }

    @if (!Model.Loans.Any())
    {
        <div class="p-4 text-muted">You haven't applied for any loans yet.</div>
    }
</div>