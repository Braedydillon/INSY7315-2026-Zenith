@{
    ViewData["Title"] = "My Account";
}

<div class="client-dashboard">

    <div class="dashboard-header">
        <div>
            <h1>My Account</h1>
            <p>Manage your account and loan applications.</p>
        </div>
    </div>

    <div class="account-card">
        <div class="account-icon">
            <i class="bi bi-person-circle"></i>
        </div>

        <div class="account-info">
            <span class="account-label">Signed in as</span>
            <h3>@ViewBag.Email</h3>
            <span class="account-badge">Client</span>
        </div>
    </div>

    <div class="dashboard-actions">

        <a asp-controller="Loan" asp-action="Index" class="dashboard-card">

            <div class="dashboard-card-icon">
                <i class="bi bi-cash-coin"></i>
            </div>

            <div>
                <h3>My Applications</h3>
                <p>View and track your loan applications.</p>
            </div>
        </a>

        <a asp-controller="Loan" asp-action="Apply" class="dashboard-card">

            <div class="dashboard-card-icon">
                <i class="bi bi-file-earmark-text"></i>
            </div>

            <div>
                <h3>Apply for loan</h3>
                <p>Apply for a new loan.</p>
            </div>
        </a>

    </div>

    <a asp-controller="Chatbot" asp-action="Index" title="Chat with our assistant"
       style="position:fixed; right:24px; bottom:24px; z-index:1000; background:#1769E0; color:#fff;
              padding:14px 22px; border-radius:999px; text-decoration:none; font-weight:600;
              box-shadow:0 4px 14px rgba(0,0,0,.25);">
        💬 Chat with Assistant
    </a>

</div>