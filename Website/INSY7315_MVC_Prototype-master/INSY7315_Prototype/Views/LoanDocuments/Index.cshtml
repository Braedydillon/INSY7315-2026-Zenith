@using INSY7315_Prototype.Controllers
@{
    ViewData["Title"] = "Loan Documents";
    var loanId = (string)ViewBag.LoanId;
    var files = (List<string>)ViewBag.Files;
    var requests = (List<LoanDocumentsController.DocumentRequest>)ViewBag.Requests;
    var isClient = User.IsInRole("client");
    var isManager = User.IsInRole("admin");
}
<div class="container py-4">
    <div class="mb-4">
        <h1 class="fw-bold">Loan Documents</h1>
        <p class="text-muted">Application #@loanId</p>
    </div>
    @if (TempData["DocumentError"] != null) { <div class="alert alert-danger">@TempData["DocumentError"]</div> }
    @if (TempData["DocumentSuccess"] != null) { <div class="alert alert-success">@TempData["DocumentSuccess"]</div> }

    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <h5 class="mb-3">Document requests</h5>
            @if (!requests.Any())
            {
                <p class="text-muted mb-0">No additional documents have been requested.</p>
            }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var request in requests)
                    {
                        <div class="list-group-item px-0 py-3">
                            <div class="d-flex justify-content-between flex-wrap gap-2">
                                <div>
                                    <strong>@request.DocumentType</strong>
                                    <div class="small text-muted">Requested by @request.RequestedBy · @request.RequestedAtUtc.ToLocalTime().ToString("dd MMM yyyy")</div>
                                    @if (!string.IsNullOrWhiteSpace(request.Note))
                                    {
                                        <div class="small mt-1">@request.Note</div>
                                    }
                                </div>
                                <div><span class="badge @(request.Status == "Submitted" ? "bg-success" : "bg-warning text-dark")">@request.Status</span></div>
                            </div>
                            @if (isClient && request.Status == "Requested")
                            {
                                <form asp-controller="LoanDocuments" asp-action="Upload" asp-route-loanId="@loanId"
                                      method="post" enctype="multipart/form-data" class="mt-3">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="requestId" value="@request.Id" />
                                    <div class="d-flex gap-2 flex-wrap">
                                        <input name="document" type="file" accept=".pdf,.jpg,.jpeg,.png" class="form-control" required style="max-width:360px" />
                                        <button class="btn btn-sm btn-primary" type="submit">Upload requested file</button>
                                    </div>
                                </form>
                            }
                            @if (request.Status == "Submitted" && !string.IsNullOrWhiteSpace(request.UploadedFileName))
                            {
                                <a class="btn btn-sm btn-outline-primary mt-2" asp-controller="LoanDocuments" asp-action="Download"
                                   asp-route-loanId="@loanId" asp-route-fileName="@request.UploadedFileName">Download response</a>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    @if (!isClient)
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h5 class="mb-3">Request another document</h5>
                <form asp-controller="LoanDocuments" asp-action="RequestDocument" asp-route-loanId="@loanId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <div class="col-md-5">
                            <label class="form-label" for="documentType">Document type</label>
                            <select id="documentType" name="documentType" class="form-select" required>
                                <option value="">Select...</option>
                                <option>ID document</option>
                                <option>Proof of address</option>
                                <option>Bank statement</option>
                                <option>Payslip</option>
                                <option>Other</option>
                            </select>
                        </div>
                        <div class="col-md-7">
                            <label class="form-label" for="note">Message to client (optional, required for Other)</label>
                            <input id="note" name="note" maxlength="500" class="form-control" placeholder="e.g. Please provide your latest payslip" />
                        </div>
                        <div class="col-12"><button type="submit" class="btn btn-primary">Send document request</button></div>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-4">
                <h5 class="mb-3">Upload an additional document</h5>
                <form asp-controller="LoanDocuments" asp-action="Upload" asp-route-loanId="@loanId" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <label for="document" class="form-label">PDF, JPG or PNG (maximum 5 MB)</label>
                    <input id="document" name="document" type="file" accept=".pdf,.jpg,.jpeg,.png" class="form-control mb-3" required />
                    <button type="submit" class="btn btn-primary">Upload Document</button>
                </form>
            </div>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <h5 class="mb-3">Uploaded documents</h5>
            @if (!files.Any()) { <p class="text-muted mb-0">No documents uploaded yet.</p> }
            else
            {
                <div class="list-group list-group-flush">
                    @foreach (var file in files)
                    {
                        <div class="list-group-item d-flex justify-content-between align-items-center gap-3 px-0">
                            <span class="text-break">@file</span>
                            <a class="btn btn-sm btn-outline-primary" asp-controller="LoanDocuments" asp-action="Download"
                               asp-route-loanId="@loanId" asp-route-fileName="@file">Download</a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
    @if (isClient)
    {
        <a asp-controller="Loan" asp-action="Index" class="btn btn-link mt-3">Back to My Loans</a>
    }
    else
    {
        <a asp-controller="@(isManager ? "Manager" : "Staff")" asp-action="AllApplications" class="btn btn-link mt-3">Back to Applications</a>
    }
</div>
