@model INSY7315_Prototype.ViewModels.ManagerDashboardViewModel

@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="manager-page">

    <!-- Header -->
    <div class="manager-header">

        <div>
            <span class="manager-label">BRIDGE&ANCHOR</span>

            <h1>Manager Dashboard</h1>

            <p>
                Review applications, monitor clients and manage loan activity.
            </p>
        </div>

    </div>


    <!-- Dashboard Statistics -->
    <div class="manager-stats">

        <!-- Total Applications -->
        <div class="manager-stat-card">

            <div class="stat-top">
                <div class="stat-icon">A</div>
            </div>

            <span>Total Applications</span>

            <strong>@Model.TotalApplications</strong>

        </div>


        <!-- Needs Review -->
        <div class="manager-stat-card pending">

            <div class="stat-top">
                <div class="stat-icon">!</div>
            </div>

            <span>Needs Review</span>

            <strong>@Model.PendingApplications</strong>

        </div>


        <!-- Approved -->
        <div class="manager-stat-card">

            <div class="stat-top">
                <div class="stat-icon">✓</div>
            </div>

            <span>Approved</span>

            <strong>@Model.ApprovedApplications</strong>

        </div>


        <!-- Rejected -->
        <div class="manager-stat-card">

            <div class="stat-top">
                <div class="stat-icon">R</div>
            </div>

            <span>Rejected</span>

            <strong>@Model.RejectedApplications</strong>

        </div>

    </div>


    <!-- Dashboard Content -->
    <div class="manager-dashboard-grid">


        <!-- Recent Applications -->
        <div class="manager-panel">

            <div class="manager-panel-header">

                <div class="manager-panel-title">

                    <h2>Recent Applications</h2>

                    <p> Applications requiring your attention </p>

                </div>

                <a href="#" class="view-all-link"> View All → </a>

            </div>


            <div class="application-list">

                @if (Model.RecentApplications != null && Model.RecentApplications.Any())
                {
                    foreach (var application in Model.RecentApplications)
                    {
                        <div class="application-row">

                            @* Applicant Initial *@
                            <div class="applicant-icon">

                                @if (!string.IsNullOrWhiteSpace(application.ClientDetails?.FullNameAndSurname))
                                {
                                    @application.ClientDetails.FullNameAndSurname.Substring(0, 1).ToUpper()
                                }
                                else
                                {
                                    <span>?</span>
                                }

                            </div>


                            @* Applicant Information *@
                            <div class="applicant-details">

                                <strong>
                                    @(string.IsNullOrWhiteSpace(application.ClientDetails?.FullNameAndSurname)? "Unknown Applicant" : application.ClientDetails.FullNameAndSurname)
                                </strong>

                                <span> Application #@application.ApplicationId </span>

                            </div>


                            <!-- Requested Amount -->
                            <div class="application-amount">

                                R @application.RequestedAmount.ToString("N2")

                            </div>


                            @* Status *@
                            <span class="application-status @application.Status.ToLower()"> @application.Status </span>


                            @* Actions *@
                            <div class="application-actions">

                                <a asp-controller="Manager" asp-action="Review" asp-route-id="@application.ApplicationId" class="action-view"> View </a>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="no-applications">

                        <p> No loan applications found.</p>

                    </div>
                }

            </div>

        </div>


        @* Needs Attention *@
        <div class="attention-panel">

            <span class="attention-label"> MANAGER ACTION </span>

            <h2> Applications Need Review </h2>

            <p>
                There are currently applications waiting for
                your review. Check the applicant information
                before making a decision.
            </p>


            <div class="pending-number">

                <strong> @Model.PendingApplications </strong>

                <span> applications needing review </span>

            </div>


            <a href="#" class="review-button btn-shadow"> Review Applications </a>

        </div>

    </div>


    @* Quick Actions *@
    <div class="manager-section">

        <div class="manager-section-heading">

            <h2>Quick Actions</h2>

            <p>Access commonly used management functions.</p>

        </div>


        <div class="manager-actions">


           @* Applications *@
            <a href="#" class="manager-action-card">

                <div class="manager-action-icon"> A </div>

                <strong> Loan Applications </strong>

                <span> Review and manage client applications. </span>

            </a>


            <!-- Clients -->
            <a href="#" class="manager-action-card">

                <div class="manager-action-icon">C</div>

                <strong> Clients </strong>

                <span> View client information and activity. </span>

            </a>


            @* Reports *@
            <a href="#" class="manager-action-card">

                <div class="manager-action-icon"> R </div>

                <strong> Reports </strong>

                <span> View loan and business reports.</span>

            </a>

        </div>

    </div>

</div>