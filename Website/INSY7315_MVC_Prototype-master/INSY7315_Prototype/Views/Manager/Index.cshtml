@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="manager-page">

   

    <div class="manager-header">

        <div>
            <span class="manager-label">BRIDGE&ANCHOR</span>

            <h1>Manager Dashboard</h1>

            <p>
                Review applications, monitor clients and manage loan activity.
            </p>
        </div>

    </div>


    

    <div class="manager-stats">

        <!-- Total Clients -->

        <div class="manager-stat-card">

            <div class="stat-top">

                <div class="stat-icon">
                    C
                </div>

                <span class="stat-change">
                    +8%
                </span>

            </div>

            <span>Total Clients</span>

            <strong>124</strong>

        </div>


        <!-- Applications -->

        <div class="manager-stat-card">

            <div class="stat-top">

                <div class="stat-icon">
                    A
                </div>

                <span class="stat-change">
                    +5%
                </span>

            </div>

            <span>Total Applications</span>

            <strong>48</strong>

        </div>


        <!-- Pending -->

        <div class="manager-stat-card pending">

            <div class="stat-top">

                <div class="stat-icon">
                    !
                </div>

                <span class="stat-change">
                    12
                </span>

            </div>

            <span>Needs Review</span>

            <strong>12</strong>

        </div>


        <!-- Active Loans -->

        <div class="manager-stat-card">

            <div class="stat-top">

                <div class="stat-icon">
                    L
                </div>

                <span class="stat-change">
                    +3%
                </span>

            </div>

            <span>Active Loans</span>

            <strong>36</strong>

        </div>

    </div>


   

    <div class="manager-dashboard-grid">


        <!-- Recent Applications -->

        <div class="manager-panel">

            <div class="manager-panel-header">

                <div class="manager-panel-title">

                    <h2>Recent Applications</h2>

                    <p>
                        Applications requiring your attention
                    </p>

                </div>

                <a href="#" class="view-all-link">
                    View All →
                </a>

            </div>


            <div class="application-list">


                <!-- Application 1 -->

                <div class="application-row">

                    <div class="applicant-icon">
                        JS
                    </div>

                    <div class="applicant-details">

                        <strong>
                            John Smith
                        </strong>

                        <span>
                            Application #APP001
                        </span>

                    </div>

                    <div class="application-amount">
                        R50,000
                    </div>

                    <span class="application-status pending">
                        Pending
                    </span>

                    <div class="application-actions">

                        <a href="#" class="action-view">
                            View
                        </a>

                        <a href="#" class="action-approve">
                            Approve
                        </a>

                        <a href="#" class="action-decline">
                            Decline
                        </a>

                    </div>

                </div>


                <!-- Application 2 -->

                <div class="application-row">

                    <div class="applicant-icon">
                        SN
                    </div>

                    <div class="applicant-details">

                        <strong>
                            Sarah Naidoo
                        </strong>

                        <span>
                            Application #APP002
                        </span>

                    </div>

                    <div class="application-amount">
                        R25,000
                    </div>

                    <span class="application-status pending">
                        Pending
                    </span>

                    <div class="application-actions">

                        <a href="#" class="action-view">
                            View
                        </a>

                        <a href="#" class="action-approve">
                            Approve
                        </a>

                        <a href="#" class="action-decline">
                            Decline
                        </a>

                    </div>

                </div>


                <!-- Application 3 -->

                <div class="application-row">

                    <div class="applicant-icon">
                        DJ
                    </div>

                    <div class="applicant-details">

                        <strong>
                            David Jones
                        </strong>

                        <span>
                            Application #APP003
                        </span>

                    </div>

                    <div class="application-amount">
                        R75,000
                    </div>

                    <span class="application-status approved">
                        Approved
                    </span>

                    <div class="application-actions">

                        <a href="#" class="action-view">
                            View
                        </a>

                    </div>

                </div>


                <!-- Application 4 -->

                <div class="application-row">

                    <div class="applicant-icon">
                        MD
                    </div>

                    <div class="applicant-details">

                        <strong>
                            Michael Dlamini
                        </strong>

                        <span>
                            Application #APP004
                        </span>

                    </div>

                    <div class="application-amount">
                        R40,000
                    </div>

                    <span class="application-status pending">
                        Pending
                    </span>

                    <div class="application-actions">

                        <a href="#" class="action-view">
                            View
                        </a>

                        <a href="#" class="action-approve">
                            Approve
                        </a>

                        <a href="#" class="action-decline">
                            Decline
                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- Needs Attention -->

        <div class="attention-panel">

            <span class="attention-label">
                MANAGER ACTION
            </span>

            <h2>
                Applications Need Review
            </h2>

            <p>
                There are currently applications waiting for
                your review. Check the applicant information
                before making a decision.
            </p>

            <div class="pending-number">

                <strong>12</strong>

                <span>
                    pending applications
                </span>

            </div>

            <a href="#" class="review-button">
                Review Applications
            </a>

        </div>

    </div>


   

    <div class="manager-section">

        <div class="manager-section-heading">

            <h2>
                Quick Actions
            </h2>

            <p>
                Access commonly used management functions.
            </p>

        </div>


        <div class="manager-actions">


            <!-- Applications -->

            <a href="#" class="manager-action-card">

                <div class="manager-action-icon">
                    A
                </div>

                <strong>
                    Loan Applications
                </strong>

                <span>
                    Review and manage client applications.
                </span>

            </a>


            <!-- Clients -->

            <a href="#" class="manager-action-card">

                <div class="manager-action-icon">
                    C
                </div>

                <strong>
                    Clients
                </strong>

                <span>
                    View client information and activity.
                </span>

            </a>


            <!-- Reports -->

            <a href="#" class="manager-action-card">

                <div class="manager-action-icon">
                    R
                </div>

                <strong>
                    Reports
                </strong>

                <span>
                    View loan and business reports.
                </span>

            </a>

        </div>

    </div>

</div>
