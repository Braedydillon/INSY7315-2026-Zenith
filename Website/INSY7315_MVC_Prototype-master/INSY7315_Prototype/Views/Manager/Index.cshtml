@model INSY7315_Prototype.ViewModels.ManagerDashboardViewModel

@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="manager-page">

    <!-- Header -->
    <div class="manager-header">

        <div>
            <span class="manager-label">BRIDGE&ANCHOR</span>

            <h1>Manager Dashboard</h1>

            <p>
                Review applications, monitor clients and manage loan activity.
            </p>
        </div>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <!-- Dashboard Statistics -->
    <div class="manager-stats">

        <!-- Total Applications -->
        <div class="manager-stat-card">

            <div class="stat-top">
                <div class="stat-icon">A</div>
            </div>

            <span>Total Applications</span>

            <strong>@Model.TotalApplications</strong>

        </div>


        <!-- Needs Review -->
        <div class="manager-stat-card pending">

            <div class="stat-top">
                <div class="stat-icon">!</div>
            </div>

            <span>Pending Action</span>
            <strong>@Model.PendingApplications</strong>

        </div>


        <!-- Approved -->
        <div class="manager-stat-card">

            <div class="stat-top">
                <div class="stat-icon">✓</div>
            </div>

            <span>Approved</span>

            <strong>@Model.ApprovedApplications</strong>

        </div>


        <!-- Rejected -->
        <div class="manager-stat-card">

            <div class="stat-top">
                <div class="stat-icon">R</div>
            </div>

            <span>Rejected</span>

            <strong>@Model.RejectedApplications</strong>

        </div>

    </div>


    <!-- Dashboard Content -->
    <div class="manager-dashboard-grid">


        <!-- Recent Applications -->
        <div class="manager-panel">

            <div class="manager-panel-header">

                <div class="manager-panel-title">

                    <h2>Recent Applications</h2>

                    <p> Applications requiring your attention </p>

                </div>

                <a asp-controller="Manager" asp-action="AllApplications" class="btn-primary-custom btn-shadow"> View All Applications </a>

            </div>


            <div class="application-list">

                @if (Model.RecentApplications != null && Model.RecentApplications.Any())
                {
                    foreach (var application in Model.RecentApplications)
                    {
                        <div class="application-row">

                            @* Applicant Initial *@
                            <div class="applicant-icon">

                                @if (!string.IsNullOrWhiteSpace(application.ClientDetails?.FullNameAndSurname))
                                {
                                    @application.ClientDetails.FullNameAndSurname.Substring(0, 1).ToUpper()
                                }
                                else
                                {
                                    <span>?</span>
                                }

                            </div>


                            @* Applicant Information *@
                            <div class="applicant-details">

                                <strong>
                                    @(string.IsNullOrWhiteSpace(application.ClientDetails?.FullNameAndSurname)? "Unknown Applicant" : application.ClientDetails.FullNameAndSurname)
                                </strong>

                                <span> Application #@application.ApplicationId </span>

                            </div>


                            <!-- Requested Amount -->
                            <div class="application-amount">

                                R @application.RequestedAmount.ToString("N2")

                            </div>


                            @* Status *@
                            <span class="application-status @application.Status.ToLower()"> @application.Status </span>


                            @* Actions *@
                            <div class="application-actions">

                                @if (application.Status.Equals("Submitted",StringComparison.OrdinalIgnoreCase))
                                {
                                    <a asp-controller="Manager" asp-action="Review" asp-route-id="@application.ApplicationId" class="action-view"> Verify </a>
                                }
                                else if (application.Status.Equals("UnderReview",StringComparison.OrdinalIgnoreCase))
                                {
                                    <a asp-controller="Manager" asp-action="Approval" asp-route-id="@application.ApplicationId" class="action-view"> Approve Loan </a>
                                }
                                else
                                {
                                    <a asp-controller="Manager" asp-action="Review" asp-route-id="@application.ApplicationId" class="action-view"> View Details </a>
                                }

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="no-applications">

                        <p> No loan applications found.</p>

                    </div>
                }

            </div>

        </div>


        @* Verification Action *@
        <div class="attention-panel">

            <span class="attention-label">
                MANAGER ACTION
            </span>

            <h2>Applications Need Verification</h2>

            <p>
                Verify applicant information and supporting documentation
                before applications proceed for loan approval.
            </p>

            <div class="pending-number">
                <strong>@Model.AwaitingVerification</strong>
                <span>applications awaiting verification</span>
            </div>

            <a asp-controller="Manager" asp-action="Applications" class="review-button btn-shadow"> Verify Applications </a>

             <h2>Loans That Need Approval</h2>

            <p>
                Review verified loan applications and make
                the final lending decision.
            </p>

            <div class="pending-number">
                <strong>@Model.AwaitingApproval</strong>
                <span>applications awaiting approval</span>
            </div>

            <a asp-controller="Manager" asp-action="Approvals" class="review-button btn-shadow"> Approve Loans </a>

        </div>


    <div class="manager-actions">

        <a asp-controller="Manager" asp-action="Applications" class="manager-action-card">

            <div class="manager-action-icon">V</div>

            <strong>Verify Applications</strong>

            <span>
                Check client details and submitted documentation.
            </span>

        </a>


        <a asp-controller="Manager" asp-action="Approvals" class="manager-action-card">

            <div class="manager-action-icon">A</div>

            <strong>Approve Loans</strong>

            <span>
                Make decisions on verified loan applications.
            </span>

        </a>


        <a href="#" class="manager-action-card">

            <div class="manager-action-icon">R</div>

            <strong>Reports</strong>

            <span>
                View loan and business reports.
            </span>

        </a>

    </div>

</div>