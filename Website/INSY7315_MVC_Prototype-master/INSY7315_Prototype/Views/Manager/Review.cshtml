@model INSY7315_Prototype.ViewModels.ManagerLoanApplicationViewModel

@{
    ViewData["Title"] = "Review Application";
}

<div class="manager-page">

    <div class="manager-header">

        <div>
            <span class="manager-label">BRIDGE&ANCHOR</span>

            <h1>Application Details</h1>

            <p>
                Review the information submitted by the client.
            </p>
        </div>

        <a asp-controller="Manager" asp-action="Index" class="btn-primary-custom btn-shadow"> ← Back to Dashboard </a>

    </div>


    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }


    <!-- Application Summary -->
    <div class="manager-panel">

        <div class="manager-panel-header">

            <div class="manager-panel-title">

                <h2>Application Summary</h2>

                <p>
                    Application #@Model.ApplicationId
                </p>

            </div>

            <span class="application-status @Model.Status.ToLower()"> @Model.Status </span>

        </div>


        <div class="application-details-grid">

            <div>
                <span>Applicant</span>

                <strong> @Model.ClientDetails.FullNameAndSurname </strong>
            </div>


            <div>
                <span>Email</span>

                <strong> @Model.UserEmail  </strong>
            </div>


            <div>
                <span>ID Number</span>

                <strong> @Model.ClientDetails.IdNumber  </strong>
            </div>


            <div>
                <span>Cell Number</span>

                <strong> @Model.ClientDetails.CellNo </strong>
            </div>


            <div>
                <span>Requested Amount</span>

                <strong> R @Model.RequestedAmount.ToString("N2") </strong>
            </div>


            <div>
                <span>Date Applied</span>

                <strong>
                    @(Model.ApplicantFormDate.HasValue ? Model.ApplicantFormDate.Value.ToString("dd MMMM yyyy") : "Not available")
                </strong>
            </div>

        </div>

    </div>


    <!-- Loan Details -->
    <div class="manager-panel">

        <div class="manager-panel-header">

            <div class="manager-panel-title">

                <h2>Loan Details</h2>

                <p>
                    Requested loan information.
                </p>

            </div>

        </div>


        <div class="application-details-grid">

            <div>
                <span>Amount Requested</span>

                <strong> R @Model.RequestedAmount.ToString("N2") </strong>
            </div>


            <div>
                <span>Status</span>

                <strong> @Model.Status </strong>
            </div>

        </div>


        <div class="application-reason">

            <span>Reason for Loan</span>

            <p>
                @(string.IsNullOrWhiteSpace(Model.ReasonForLoan) ? "No reason provided." : Model.ReasonForLoan)
            </p>

        </div>

    </div>


    <!-- More client information -->
    <div class="manager-panel">

        <div class="manager-panel-header">

            <div class="manager-panel-title">

                <h2>Client Information</h2>

                <p>
                    Additional information submitted with the application.
                </p>

            </div>

        </div>


        <div class="application-details-grid">

            <div>
                <span>Home Telephone</span>
                <strong>@Model.HomeTelNo</strong>
            </div>

            <div>
                <span>Marital Status</span>
                <strong>@Model.MarriedOrUnmarried</strong>
            </div>

            <div>
                <span>Physical Address</span>
                <strong>@Model.CurrentPhysicalAddress</strong>
            </div>

            <div>
                <span>Postal Address</span>
                <strong>@Model.PostalAddress</strong>
            </div>

            <div>
                <span>Residence Duration</span>
                <strong>@Model.ResidenceMonths</strong>
            </div>

        </div>

    </div>


    <!-- Employment -->
    <div class="manager-panel">

        <div class="manager-panel-header">

            <div class="manager-panel-title">
                <h2>Employment Information</h2>
            </div>

        </div>


        <div class="application-details-grid">

            <div>
                <span>Company</span>
                <strong>@Model.CompanyName</strong>
            </div>

            <div>
                <span>Occupation</span>
                <strong>@Model.Occupation</strong>
            </div>

            <div>
                <span>Work Telephone</span>
                <strong>@Model.WorkTelephone</strong>
            </div>

        </div>

    </div>


    <!-- Banking -->
    <div class="manager-panel">

        <div class="manager-panel-header">

            <div class="manager-panel-title">
                <h2>Banking Information</h2>
            </div>

        </div>


        <div class="application-details-grid">

            <div>
                <span>Bank</span>
                <strong>@Model.BankName</strong>
            </div>

            <div>
                <span>Account Type</span>
                <strong>@Model.AccountType</strong>
            </div>

            <div>
                <span>Account Number</span>
                <strong>@Model.AccountNumber</strong>
            </div>

        </div>

    </div>


    <!-- Family / Relative -->
    <div class="manager-panel">

        <div class="manager-panel-header">

            <div class="manager-panel-title">
                <h2>Additional Contact Information</h2>
            </div>

        </div>


        <div class="application-details-grid">

            <div>
                <span>Spouse</span>
                <strong>@Model.SpouseNameAndSurname</strong>
            </div>

            <div>
                <span>Relative</span>
                <strong>@Model.Relative1Name</strong>
            </div>

            <div>
                <span>Relative Telephone</span>
                <strong>@Model.Relative1TelNumber</strong>
            </div>

        </div>

    </div>

    <!-- Manager Review -->
    <div class="manager-panel">

        <div class="manager-panel-header">
            <div class="manager-panel-title">
                <h2>Manager Review</h2>
                <p>
                    Review the application before making a final decision.
                </p>
            </div>
        </div>

        <form asp-controller="Manager" asp-action="Review" method="post" class="manager-review">

            @Html.AntiForgeryToken()

            <input type="hidden" name="ApplicationId" value="@Model.ApplicationId" />

            <div class="review-field">

                <label for="reviewNote"> Review Note </label>

                <textarea id="reviewNote"  name="Note" rows="5" maxlength="500" placeholder="Enter a note about this application..."></textarea>

                <small> Add any comments or reasons relating to your decision. </small>

            </div>

            <div class="review-actions">

                <button type="submit" name="Decision" value="decline" class="btn-decline"> Decline Application </button>

                <button type="submit" name="Decision" value="approve" class="btn-approve"> Application </button>

            </div>

        </form>

    </div>

</div>