@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 hero-content">
                <span class="hero-label">BRIDGE & ANCHOR LOANS</span>

                <h1>
                    Quick Loans
                    <span>at Your Fingertips</span>
                </h1>

                <p class="hero-text">
                    Simple and accessible lending solutions designed to
                    help you when you need financial support.
                </p>

                <div class="hero-buttons">
                    <a href="#services"
                       class="btn btn-primary-custom btn-shadow">
                        Explore Our Services
                    </a>

                    <a href="#contact"
                       class="btn btn-outline-custom btn-shadow">
                        Contact Us
                    </a>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-image-wrapper">
                    <img src="~/Images/loan-hero.jpg"
                         alt="Financial services"
                         class="hero-image" />
                </div>
            </div>
        </div>
    </div>
</section>

<!-- NCR / Compliance Section -->
<section class="ncr-section">
    <div class="ncr-container">
        <div class="ncr-content">
            <span class="home-section-label">
                TRUST & COMPLIANCE
            </span>

            <h2>Committed to Responsible Lending</h2>

            <p>
                At Bridge & Anchor, we believe that providing financial
                services comes with a responsibility to our clients.
                Our loan processes are designed to support transparency,
                responsible lending and compliance with the requirements
                of the National Credit Act.
            </p>

            <p>
                Our software provider is NCR compliant and supports the
                calculation of contract interest and fees, as well as
                the preparation of pre-agreement statements and quotations.
            </p>
        </div>

        <div class="ncr-card">
            <div class="ncr-logo">
                <img src="~/Images/ncr_logo.jpg"
                     alt="NCR Compliance" />
            </div>

            <h3>NCR Compliant</h3>

            <p>
                Bridge & Anchor is committed to responsible lending
                and transparent financial services. Our processes
                are designed to support compliance with the
                requirements of the National Credit Act.
            </p>

            <div class="ncr-points">
                <div>
                    <span>✓</span>
                    <p>Transparent quotations</p>
                </div>

                <div>
                    <span>✓</span>
                    <p>Clear credit agreements</p>
                </div>

                <div>
                    <span>✓</span>
                    <p>Affordability considerations</p>
                </div>

                <div>
                    <span>✓</span>
                    <p>Responsible client support</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Loan Information -->
<section class="loan-info-section">
    <div class="container">
        <div class="section-heading text-center">
            <span>OUR LOAN OPTIONS</span>
            <h2>Flexible Lending Solutions</h2>

            <p>
                Bridge & Anchor Loans offers short-term lending
                solutions designed around your financial needs.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="info-card">
                    <div class="info-icon">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                    <h3>Cash Loans</h3>

                    <p>
                        Access cash when you need it with a
                        straightforward loan application process.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-card">
                    <div class="info-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                    <h3>Flexible Terms</h3>

                    <p>
                        Loan periods range from 1 month up to
                        6 months, depending on your application
                        and affordability.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="info-card">
                    <div class="info-icon">
                        <i class="bi bi-person-check"></i>
                    </div>

                    <h3>Personal Service</h3>

                    <p>
                        Our team provides personalised assistance
                        throughout the loan application process.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Loan Range -->
<section class="loan-range-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="section-label">OUR LOAN RANGE</span>

                <h2>
                    Financial Support
                    <span>When You Need It</span>
                </h2>

                <p>
                    Bridge & Anchor Loans provides loans ranging
                    from R500 to R20,000, with repayment periods
                    from 1 to 6 months.
                </p>

                <a asp-controller="LoanApplication"
                   asp-action="Index"
                   class="btn btn-primary-custom btn-shadow">
                    View Loan Requirements
                </a>
            </div>

            <div class="col-lg-6">
                <div class="loan-range-card">
                    <div>
                        <small>LOAN AMOUNTS</small>
                        <strong>R500 – R20,000</strong>
                    </div>

                    <div>
                        <small>LOAN PERIOD</small>
                        <strong>1 – 6 Months</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Supporting Documents -->
<section class="documents-section">
    <div class="container">
        <div class="section-heading text-center">
            <span>APPLICATION REQUIREMENTS</span>
            <h2>What You'll Need</h2>

            <p>
                Have the following documents ready to make
                your application process easier.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-sm-6 col-lg-3">
                <div class="document-card">
                    <div class="document-number">01</div>

                    <h3>Bank Statements</h3>

                    <p>
                        Your latest 3 months of bank statements.
                    </p>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="document-card">
                    <div class="document-number">02</div>

                    <h3>Proof of Address</h3>

                    <p>
                        A recent document confirming your
                        residential address.
                    </p>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="document-card">
                    <div class="document-number">03</div>

                    <h3>Proof of Income</h3>

                    <p>
                        Your latest payslip or other acceptable
                        proof of income.
                    </p>
                </div>
            </div>

            <div class="col-sm-6 col-lg-3">
                <div class="document-card">
                    <div class="document-number">04</div>

                    <h3>ID Copy</h3>

                    <p>
                        A clear copy of your identification document.
                    </p>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a asp-controller="LoanApplication"
               asp-action="Index"
               class="btn btn-primary-custom btn-shadow">
                View All Requirements
            </a>
        </div>
    </div>
</section>

<!-- Why Choose Us -->
<section class="why-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="section-label">
                    WHY BRIDGE & ANCHOR?
                </span>

                <h2>
                    A Lending Provider
                    <span>You Can Rely On</span>
                </h2>

                <p>
                    Bridge & Anchor Loans was established in
                    1991 and has been providing credit services
                    to the Pietermaritzburg community and
                    surrounding areas.
                </p>

                <p>
                    Our focus is on providing accessible lending
                    solutions with a simple application process
                    and personalised customer service.
                </p>
            </div>

            <div class="col-lg-6">
                <div class="benefits-grid">
                    <div class="benefit-item">
                        <strong>01</strong>
                        <h3>Accessible</h3>
                        <p>Simple access to loan services.</p>
                    </div>

                    <div class="benefit-item">
                        <strong>02</strong>
                        <h3>Flexible</h3>
                        <p>Short-term repayment options.</p>
                    </div>

                    <div class="benefit-item">
                        <strong>03</strong>
                        <h3>Personalised</h3>
                        <p>Support throughout your application.</p>
                    </div>

                    <div class="benefit-item">
                        <strong>04</strong>
                        <h3>Experienced</h3>
                        <p>Established in 1991.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Services -->
<section class="services-section" id="services">
    <div class="container">
        <div class="section-heading text-center">
            <span>OUR SERVICES</span>
            <h2>How We Can Help</h2>

            <p>
                Explore the lending services available
                from Bridge & Anchor Loans.
            </p>
        </div>

        <div class="row g-4">
            <!-- Cash Loans -->
            <div class="col-md-4">
                <div class="service-card">
                    <div class="service-icon">💰</div>

                    <h3>Cash Loans</h3>

                    <p>
                        Short-term cash loans for eligible
                        applicants.
                    </p>

                    <a asp-controller="LoanApplication"
                       asp-action="Index">
                        Learn More →
                    </a>
                </div>
            </div>

            <!-- Loan Applications -->
            <div class="col-md-4">
                <div class="service-card">
                    <div class="service-icon">📄</div>

                    <h3>Loan Applications</h3>

                    <p>
                        Submit your information and begin
                        your loan application online.
                    </p>

                    <a asp-controller="Loan"
                       asp-action="Apply">
                        Apply Now →
                    </a>
                </div>
            </div>

            <!-- Customer Support -->
            <div class="col-md-4">
                <div class="service-card">
                    <div class="service-icon">🤝</div>

                    <h3>Customer Support</h3>

                    <p>
                        Get assistance from our team with
                        your loan enquiry.
                    </p>

                    <a href="#contact">
                        Contact Us →
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Meet the Staff -->
<section class="staff-introduction">
    <div class="staff-introduction-header">
        <span class="home-section-label">
            MEET THE TEAM
        </span>

        <h2>Meet Our Staff</h2>

        <p>
            Our experienced team is here to assist you with
            your financial needs and guide you through the
            loan process.
        </p>
    </div>

    <div class="staff-grid">
        <!-- Lorraine -->
        <div class="staff-person-card">
            <div class="staff-person-image">
                <img src="~/Images/Staff Pics/Staff-Lorraine.jpg"
                     alt="Lorraine - Bridge & Anchor staff member" />
            </div>

            <div class="staff-person-info">
                <h3>Lorraine</h3>
                <span>Loan Consultant</span>

                <p>
                    Our team is here to provide professional
                    assistance and support throughout your
                    loan journey.
                </p>
            </div>
        </div>

        <!-- Mandy -->
        <div class="staff-person-card">
            <div class="staff-person-image">
                <img src="~/Images/Staff Pics/Staff-Mandy.jpg"
                     alt="Mandy - Bridge & Anchor staff member" />
            </div>

            <div class="staff-person-info">
                <h3>Mandy</h3>
                <span>Loan Consultant</span>

                <p>
                    Helping clients understand their options
                    and providing support throughout the
                    application process.
                </p>
            </div>
        </div>

        <!-- Nomntobeko -->
        <div class="staff-person-card">
            <div class="staff-person-image">
                <img src="~/Images/Staff Pics/Staff-Nomtobeko.jpg"
                     alt="Nomntobeko - Bridge & Anchor staff member" />
            </div>

            <div class="staff-person-info">
                <h3>Nomntobeko</h3>
                <span>Loan Consultant</span>

                <p>
                    Providing clients with guidance and
                    assistance when applying for financial
                    services.
                </p>
            </div>
        </div>

        <!-- Sheryl -->
        <div class="staff-person-card">
            <div class="staff-person-image">
                <img src="~/Images/Staff Pics/Staff-Sheryl.jpg"
                     alt="Sheryl - Bridge & Anchor staff member" />
            </div>

            <div class="staff-person-info">
                <h3>Sheryl</h3>
                <span>Loan Consultant</span>

                <p>
                    Assisting clients with their enquiries
                    and supporting them throughout the
                    loan process.
                </p>
            </div>
        </div>

        <!-- Shoba -->
        <div class="staff-person-card">
            <div class="staff-person-image">
                <img src="~/Images/Staff Pics/Staff-Shoba.jpg"
                     alt="Shoba - Bridge & Anchor staff member" />
            </div>

            <div class="staff-person-info">
                <h3>Shoba</h3>
                <span>Loan Consultant</span>

                <p>
                    Providing friendly assistance and
                    helping clients navigate their
                    financial options.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Contact CTA -->
<section class="contact-section" id="contact">
    <div class="container">
        <div class="contact-box">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <span>READY TO GET STARTED?</span>

                    <h2>
                        Let's Find the Right
                        Loan for You.
                    </h2>

                    <p>
                        Contact Bridge & Anchor Loans to
                        enquire about our lending services.
                    </p>
                </div>

                <div class="col-lg-5 text-lg-end">
                    <a href="mailto:info@bridgeanchor.co.za"
                       class="btn btn-light-custom btn-shadow">
                        Email Us
                    </a>
                </div>
            </div>
        </div>
    </div>
    <a asp-controller="Chatbot" asp-action="Index" title="Chat with our assistant"
       style="position:fixed; right:24px; bottom:24px; z-index:1000; background:#1769E0; color:#fff;
              padding:14px 22px; border-radius:999px; text-decoration:none; font-weight:600;
              box-shadow:0 4px 14px rgba(0,0,0,.25);">
        💬 Chat with Assistant
    </a>
</section>
