@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 hero-content">

                <span class="hero-label">BRIDGE & ANCHOR LOANS</span>

                <h1>
                    Quick Loans
                    <span>at Your Fingertips</span>
                </h1>

                <p class="hero-text">
                    Simple and accessible lending solutions designed to
                    help you when you need financial support.
                </p>

                <div class="hero-buttons">
                    <a href="#services" class="btn btn-primary-custom"> Explore Our Services </a>

                    <a href="#contact" class="btn btn-outline-custom"> Contact Us </a>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="hero-image-wrapper">
                    <img src="~/images/loan-hero.jpg" alt="Financial services" class="hero-image" />
                </div>
            </div>

        </div>
    </div>
</section>

<!-- NCR / Compliance Section -->

<section class="ncr-section">
    <div class="ncr-container">
        <div class="ncr-content">
            <span class="home-section-label">
                TRUST & COMPLIANCE
            </span>

            <h2>
                Committed to Responsible Lending
            </h2>

            <p>
                At Bridge&Anchor, we believe that providing financial
                services comes with a responsibility to our clients.
                Our loan processes are designed to support transparency,
                responsible lending and compliance with the requirements
                of the National Credit Act.
            </p>

            <p>
                Our software provider is NCR compliant and supports the
                calculation of contract interest and fees, as well as
                the preparation of pre-agreement statements and quotations.
            </p>

            <a asp-controller="Home"
               asp-action="Index"
               class="ncr-button">
                Learn More About Our Policies
            </a>

        </div>
        <div class="ncr-card">

            <div class="ncr-logo">
                <img src="~/Images/ncr_logo.jpg"
                     alt="NCR Compliance" />
            </div>

            <h3>
                NCR Compliant
            </h3>

            <p>
                Bridge&Anchor is committed to responsible lending and
                transparent financial services. Our processes are designed
                to support compliance with the requirements of the
                National Credit Act.
            </p>
            <div class="ncr-points">
                <div>
                    <span>✓</span>
                    <p>Transparent quotations</p>
                </div>
                <div>
                    <span>✓</span>
                    <p>Clear credit agreements</p>
                </div>
                <div>
                    <span>✓</span>
                    <p>Affordability considerations</p>
                </div>
                <div>
                    <span>✓</span>
                    <p>Responsible client support</p>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- Loan Information -->
<section class="loan-info-section">
    <div class="container">

        <div class="section-heading text-center">
            <span>OUR LOAN OPTIONS</span>
            <h2>Flexible Lending Solutions</h2>
            <p>
                Bridge & Anchor Loans offers short-term lending solutions
                designed around your financial needs.
            </p>
        </div>

        <div class="row g-4">

            <div class="col-md-4">
                <div class="info-card">

                    <div class="info-icon">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                    <h3>Cash Loans</h3>

                    <p>
                        Access cash when you need it with a straightforward
                        loan application process.
                    </p>

                    <a href="#services"> Learn More →</a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="info-card">
                    <div class="info-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>

                    <h3>Flexible Terms</h3>

                    <p>
                        Loan periods range from 1 month up to 6 months,
                        depending on your application and affordability.
                    </p>

                    <a href="#services"> View Options → </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="info-card">
                    <div class="info-icon">
                        <i class="bi bi-person-check"></i>
                    </div>

                    <h3>Personal Service</h3>

                    <p>
                        Our team provides personalised assistance throughout
                        the loan application process.
                    </p>
                    <a href="#contact"> Contact Us → </a>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- Loan Range -->
<section class="loan-range-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="section-label">OUR LOAN RANGE</span>

                <h2>
                    Financial Support
                    <span>When You Need It</span>
                </h2>

                <p>
                    Bridge & Anchor Loans provides loans ranging from
                    R300 to R7,000, with repayment periods from 1 to
                    6 months.
                </p>

                <a href="#services" class="btn btn-primary-custom">
                    Learn About Our Services
                </a>
            </div>
            <div class="col-lg-6">
                <div class="loan-range-card">
                    <div>
                        <small>LOAN AMOUNTS</small>
                        <strong>R300 – R7,000</strong>
                    </div>
                    <div>
                        <small>LOAN PERIOD</small>
                        <strong>1 – 6 Months</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- What You Need -->
<section class="documents-section">
    <div class="container">
        <div class="section-heading text-center">

            <span>APPLICATION REQUIREMENTS</span>

            <h2>What You'll Need</h2>

            <p>
                Have the following documents ready to make your
                application process easier.
            </p>
        </div>
        <div class="row g-4">
            <div class="col-sm-6 col-lg-3">
                <div class="document-card">

                    <div class="document-number">01</div>

                    <h3>Bank Statement</h3>

                    <p>
                        Your latest 3 months of bank statements.
                    </p>

                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="document-card">

                    <div class="document-number">02</div>

                    <h3>Proof of Address</h3>

                    <p>
                        A recent document confirming your address.
                    </p>

                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="document-card">

                    <div class="document-number">03</div>

                    <h3>Payslip</h3>

                    <p>
                        Your latest payslip or proof of income.
                    </p>

                </div>
            </div>
            <div class="col-sm-6 col-lg-3">
                <div class="document-card">

                    <div class="document-number">04</div>

                    <h3>ID Copy</h3>

                    <p>
                        A clear copy of your identification document.
                    </p>

                </div>
            </div>
        </div>
    </div>
</section>


<!-- Why Choose Us -->
<section class="why-section">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <span class="section-label">WHY BRIDGE & ANCHOR?</span>

                <h2>
                    A Lending Provider
                    <span>You Can Rely On</span>
                </h2>

                <p>
                    Bridge & Anchor Loans was established in 1991 and
                    has been providing credit services to the
                    Pietermaritzburg community and surrounding areas.
                </p>

                <p>
                    Our focus is on providing accessible lending
                    solutions with a simple application process and
                    personalised customer service.
                </p>

            </div>
            <div class="col-lg-6">
                <div class="benefits-grid">
                    <div class="benefit-item">
                        <strong>01</strong>
                        <h3>Accessible</h3>
                        <p>
                            Simple access to loan services.
                        </p>
                    </div>
                    <div class="benefit-item">
                        <strong>02</strong>
                        <h3>Flexible</h3>
                        <p>
                            Short-term repayment options.
                        </p>
                    </div>
                    <div class="benefit-item">
                        <strong>03</strong>
                        <h3>Personalised</h3>
                        <p>
                            Support throughout your application.
                        </p>
                    </div>
                    <div class="benefit-item">
                        <strong>04</strong>
                        <h3>Experienced</h3>
                        <p>
                            Established in 1991.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


<!-- Services -->
<section class="services-section" id="services">

    <div class="container">
        <div class="section-heading text-center">
            <span>OUR SERVICES</span>

            <h2>How We Can Help</h2>

            <p>
                Explore the lending services available from
                Bridge & Anchor Loans.
            </p>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="service-card">
                    <div class="service-icon"> 💰 </div>

                    <h3>Cash Loans</h3>

                    <p>
                        Short-term cash loans for eligible applicants.
                    </p>

                    <a href="#">
                        Learn More →
                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card">
                    <div class="service-icon">
                        📄
                    </div>
                    <h3>Loan Applications</h3>

                    <p>
                        Submit your information and begin your
                        loan application.
                    </p>

                    <a href="#">
                        Apply Now →
                    </a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="service-card">
                    <div class="service-icon">
                        🤝
                    </div>

                    <h3>Customer Support</h3>
                    <p>
                        Get assistance from our team with your
                        loan enquiry.
                    </p>
                    <a href="#contact"> Contact Us → </a>
                </div>
            </div>
        </div>
    </div>
</section>

