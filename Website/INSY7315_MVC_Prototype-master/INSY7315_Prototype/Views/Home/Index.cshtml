<!-- Contact CTA -->
<section class="contact-section" id="contact">
    <div class="container">
        <div class="contact-box">
            <div class="row align-items-center">
                <div class="col-lg-7">
                    <span>READY TO GET STARTED?</span>

                    <h2>
                        Let's Find the Right
                        Loan for You.
                    </h2>

                    <p>
                        Contact Bridge & Anchor Loans to enquire
                        about our lending services.
                    </p>
                </div>
                <div class="col-lg-5 text-lg-end">
                    <a href="mailto:Bridgeanchor@gmail.com"class="btn btn-light-custom"> Email Us </a>
                </div>
            </div>
        </div>
    </div>
</section>