@model INSY7315_Prototype.ViewModels.StaffVerifyLoanViewModel
@using INSY7315_Prototype.Models
@{
    ViewData["Title"] = "Review Application";
}

<a asp-action="Index" class="text-decoration-none">&larr; Back to applications</a>
<h1 class="fw-bold mt-2">Review Application</h1>
<p class="text-muted">
    Application #@Model.ApplicationId &middot; Applied @(Model.DateApplied?.ToString("dd MMM yyyy") ?? "—")
</p>

@if (Model.RequiresManager)
{
    <div class="alert alert-warning">
        This loan is R@(LoanRules.ManagerThreshold.ToString("N0")) or more. Verify the details and send it to the manager, who makes the final decision.
    </div>
}
else
{
    <div class="alert alert-info">
        This loan is under R@(LoanRules.ManagerThreshold.ToString("N0")), so you can approve or decline it.
    </div>
}

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card p-4 h-100">
            <h5 class="mb-3">Loan</h5>
            <dl class="row mb-4">
                <dt class="col-sm-4 text-muted fw-normal">Amount</dt>
                <dd class="col-sm-8 fw-semibold">R@(Model.RequestedAmount.ToString("N0"))</dd>
                <dt class="col-sm-4 text-muted fw-normal">Reason</dt>
                <dd class="col-sm-8">@Model.ReasonForLoan</dd>
            </dl>
            <partial name="_LoanDetails" model="Model.Client" />
        </div>
    </div>

    <div class="col-lg-5">
        <form asp-action="Verify" method="post" class="card p-4">
            <input type="hidden" asp-for="ApplicationId" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <h5 class="mb-3">Verification checklist</h5>
            <div class="form-check mb-2"><input asp-for="IdVerified" class="form-check-input" /><label asp-for="IdVerified" class="form-check-label"></label></div>
            <div class="form-check mb-2"><input asp-for="AddressVerified" class="form-check-input" /><label asp-for="AddressVerified" class="form-check-label"></label></div>
            <div class="form-check mb-2"><input asp-for="EmploymentVerified" class="form-check-input" /><label asp-for="EmploymentVerified" class="form-check-label"></label></div>
            <div class="form-check mb-3"><input asp-for="BankVerified" class="form-check-input" /><label asp-for="BankVerified" class="form-check-label"></label></div>

            <div class="mb-4">
                <label asp-for="StaffNotes" class="form-label"></label>
                <textarea asp-for="StaffNotes" class="form-control" rows="3"></textarea>
                <span asp-validation-for="StaffNotes" class="text-danger"></span>
            </div>

            <div class="d-grid gap-2">
                @if (Model.RequiresManager)
                {
                    <button type="submit" name="Decision" value="Verify" class="btn btn-primary">Verify &amp; send to manager</button>
                    <button type="submit" name="Decision" value="Reject" class="btn btn-outline-danger"
                            onclick="return confirm('Reject this application?');">
                        Reject application
                    </button>
                }
                else
                {
                    <button type="submit" name="Decision" value="Approve" class="btn btn-success">Approve loan</button>
                    <button type="submit" name="Decision" value="Decline" class="btn btn-outline-danger"
                            onclick="return confirm('Decline this loan?');">
                        Decline loan
                    </button>
                }
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}