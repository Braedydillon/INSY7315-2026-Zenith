@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="staff-dashboard">

    <!-- Dashboard Header -->
    <div class="staff-header">

        <div>
            <span class="staff-label">STAFF PORTAL</span>

            <h1>Good morning, Staff Member</h1>

            <p>
                Here's an overview of the current loan activity.
            </p>
        </div>

        <div class="staff-date">
            <span>Today</span>
            <strong>17 August 2026</strong>
        </div>

    </div>


    <!-- Statistics -->
    <div class="row g-4 mb-5">

        <div class="col-md-6 col-xl-3">
            <div class="staff-stat-card">

                <div class="stat-icon">
                    📋
                </div>

                <div>
                    <span>Total Applications</span>
                    <strong>12</strong>
                </div>

            </div>
        </div>


        <div class="col-md-6 col-xl-3">
            <div class="staff-stat-card">

                <div class="stat-icon pending">
                    ⏳
                </div>

                <div>
                    <span>Pending Review</span>
                    <strong>5</strong>
                </div>

            </div>
        </div>


        <div class="col-md-6 col-xl-3">
            <div class="staff-stat-card">

                <div class="stat-icon approved">
                    ✓
                </div>

                <div>
                    <span>Approved</span>
                    <strong>3</strong>
                </div>

            </div>
        </div>


        <div class="col-md-6 col-xl-3">
            <div class="staff-stat-card">

                <div class="stat-icon clients">
                    👥
                </div>

                <div>
                    <span>Active Clients</span>
                    <strong>24</strong>
                </div>

            </div>
        </div>

    </div>


    <!-- Main Dashboard Content -->
    <div class="row g-4">

        <!-- Recent Applications -->
        <div class="col-lg-8">

            <div class="staff-panel">

                <div class="panel-header">

                    <div>
                        <span class="panel-label">APPLICATIONS</span>
                        <h2>Recent Applications</h2>
                    </div>

                    <a asp-controller="Staff"
                       asp-action="Applications"
                       class="panel-link">
                        View All →
                    </a>

                </div>


                <div class="table-responsive">

                    <table class="table staff-table">

                        <thead>
                            <tr>
                                <th>Applicant</th>
                                <th>Amount</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>

                            <tr>
                                <td>
                                    <strong>John Smith</strong>
                                </td>

                                <td>R5,000</td>

                                <td>17 Aug 2026</td>

                                <td>
                                    <span class="status-badge status-pending">
                                        Pending
                                    </span>
                                </td>

                                <td>
                                    <a href="#" class="view-link">
                                        View
                                    </a>
                                </td>
                            </tr>


                            <tr>
                                <td>
                                    <strong>Sarah Jones</strong>
                                </td>

                                <td>R3,000</td>

                                <td>17 Aug 2026</td>

                                <td>
                                    <span class="status-badge status-approved">
                                        Approved
                                    </span>
                                </td>

                                <td>
                                    <a href="#" class="view-link">
                                        View
                                    </a>
                                </td>
                            </tr>


                            <tr>
                                <td>
                                    <strong>Michael Brown</strong>
                                </td>

                                <td>R7,000</td>

                                <td>16 Aug 2026</td>

                                <td>
                                    <span class="status-badge status-review">
                                        Review
                                    </span>
                                </td>

                                <td>
                                    <a href="#" class="view-link">
                                        View
                                    </a>
                                </td>
                            </tr>


                            <tr>
                                <td>
                                    <strong>Lisa Williams</strong>
                                </td>

                                <td>R2,500</td>

                                <td>16 Aug 2026</td>

                                <td>
                                    <span class="status-badge status-approved">
                                        Approved
                                    </span>
                                </td>

                                <td>
                                    <a href="#" class="view-link">
                                        View
                                    </a>
                                </td>
                            </tr>

                        </tbody>

                    </table>
                </div>
            </div>
        </div>


        <!-- Quick Actions -->
        <div class="col-lg-4">
            <div class="staff-panel">
                <div class="panel-header">
                    <div>
                        <span class="panel-label">QUICK ACTIONS</span>
                        <h2>Staff Tools</h2>
                    </div>
                </div>
                <div class="quick-actions">

                    <a asp-controller="Staff" asp-action="Applications" class="quick-action">
                        <div class="quick-action-icon">
                            📋
                        </div>
                        <div>
                            <strong>Review Applications</strong>
                            <span>View pending applications</span>
                        </div>

                        <b>→</b>
                    </a>

                    <a asp-controller="Staff" asp-action="Clients"class="quick-action">
                        <div class="quick-action-icon">
                            👥
                        </div>
                        <div>
                            <strong>Manage Clients</strong>
                            <span>View client information</span>
                        </div>

                        <b>→</b>
                    </a>
                    <a asp-controller="Staff" asp-action="Loans" class="quick-action">

                        <div class="quick-action-icon">💰</div>

                        <div>
                            <strong>View Loans</strong>
                            <span>Manage active loans</span>
                        </div>

                        <b>→</b>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>