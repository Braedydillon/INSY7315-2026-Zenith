@model List<INSY7315_Prototype.ViewModels.ManagerLoanApplicationViewModel>
@using INSY7315_Prototype.Models

@{
    ViewData["Title"] = "All Applications";
}

<div class="manager-page">

    <div class="manager-header">

        <div>
            <span class="manager-label">BRIDGE&ANCHOR</span>

            <h1>All Applications</h1>

            <p>
                View all loan applications. Loans above
                R@(LoanRules.StaffLimit.ToString("N0")) are handled by the manager.
            </p>
        </div>

        <a asp-controller="Staff" asp-action="Index" class="btn-primary-custom btn-shadow"> ← Back to Dashboard </a>

    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    <div class="applications-summary">

        <div>
            <span>Total Applications</span>
            <strong>@Model.Count</strong>
        </div>

        <div>
            <span>Awaiting Verification</span>
            <strong>@Model.Count(x => LoanRules.StaffCanHandle(x.RequestedAmount) && LoanRules.Is(x.Status, LoanStatus.Submitted))</strong>
        </div>

        <div>
            <span>Awaiting Approval</span>
            <strong>@Model.Count(x => LoanRules.StaffCanHandle(x.RequestedAmount) && LoanRules.Is(x.Status, LoanStatus.UnderReview))</strong>
        </div>

        <div>
            <span>Approved</span>
            <strong>@Model.Count(x => LoanRules.Is(x.Status, LoanStatus.Approved))</strong>
        </div>

        <div>
            <span>Rejected</span>
            <strong>@Model.Count(x => LoanRules.Is(x.Status, LoanStatus.Rejected))</strong>
        </div>

    </div>

    <div class="manager-panel">

        <div class="manager-panel-header">

            <div class="manager-panel-title">
                <h2>Loan Applications</h2>
                <p>View and manage loan applications.</p>
            </div>

            <div class="all-applications-actions">
                <a asp-controller="Staff" asp-action="Applications" class="btn-primary-custom btn-shadow"> Verify Applications </a>
                <a asp-controller="Staff" asp-action="Approvals" class="btn-primary-custom"> Approve Loans </a>
            </div>

        </div>

        @if (Model.Any())
        {
            <div class="applications-table-wrapper">

                <table class="applications-table">

                    <thead>
                        <tr>
                            <th>Applicant</th>
                            <th>Application</th>
                            <th>Amount</th>
                            <th>Date</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var application in Model)
                        {
                            <tr>

                                <td>
                                    <div class="applicant-cell">

                                        <div class="application-avatar">
                                            @(string.IsNullOrWhiteSpace(application.ClientDetails?.FullNameAndSurname) ? "?" : application.ClientDetails.FullNameAndSurname.Substring(0, 1).ToUpper())
                                        </div>

                                        <div>
                                            <strong>
                                                @(string.IsNullOrWhiteSpace(application.ClientDetails?.FullNameAndSurname) ? "Unknown Applicant" : application.ClientDetails.FullNameAndSurname)
                                            </strong>

                                            <small>@application.UserEmail</small>
                                        </div>

                                    </div>
                                </td>

                                <td>
                                    <span class="application-number">#@application.ApplicationId</span>
                                </td>

                                <td>
                                    <strong>R @application.RequestedAmount.ToString("N2")</strong>
                                </td>

                                <td>
                                    @(application.DateApplied == default ? "—" : application.DateApplied.ToString("dd MMM yyyy"))
                                </td>

                                <td>
                                    <span class="application-status @((application.Status ?? "").ToLower())"> @application.Status </span>
                                </td>

                                <td class="application-action">

                                    @if (LoanRules.RequiresManager(application.RequestedAmount))
                                    {
                                        <span class="text-muted">Manager only</span>
                                    }
                                    else if (LoanRules.Is(application.Status, LoanStatus.Submitted))
                                    {
                                        <a asp-controller="Staff" asp-action="Review" asp-route-id="@application.ApplicationId" class="view-application-btn"> Verify → </a>
                                    }
                                    else if (LoanRules.Is(application.Status, LoanStatus.UnderReview))
                                    {
                                        <a asp-controller="Staff" asp-action="Approval" asp-route-id="@application.ApplicationId" class="view-application-btn"> Approve Loan → </a>
                                    }
                                    else
                                    {
                                        <a asp-controller="Staff" asp-action="Review" asp-route-id="@application.ApplicationId" class="view-application-btn"> View Details → </a>
                                    }

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">
                <h3>No applications found</h3>
                <p>Loan applications will appear here once submitted.</p>
            </div>
        }

    </div>

</div>