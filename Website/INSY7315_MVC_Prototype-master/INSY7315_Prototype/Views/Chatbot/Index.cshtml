@{
    ViewData["Title"] = "Bridge & Anchor Assistant";
}

<style>
    .chatbot { max-width: 720px; margin: 24px auto; background: #fff; border: 1px solid #e2e8f0; border-radius: 16px; overflow: hidden; display: flex; flex-direction: column; height: calc(100vh - 220px); min-height: 480px; box-shadow: 0 4px 18px rgba(15,23,42,.08); }
    .chatbot-header { background: #1769E0; color: #fff; padding: 14px 18px; display: flex; align-items: center; gap: 12px; }
    .chatbot-header a { color: #fff; text-decoration: none; font-size: 22px; }
    .chatbot-header strong { display: block; font-size: 17px; }
    .chatbot-header span { font-size: 12px; color: #dcebff; }
    .chatbot-log { flex: 1; overflow-y: auto; padding: 16px; background: #f5f7fb; }
    .msg { display: flex; flex-direction: column; margin-bottom: 14px; max-width: 85%; }
    .msg.user { align-items: flex-end; margin-left: auto; }
    .msg.bot { align-items: flex-start; }
    .bubble { padding: 10px 14px; border-radius: 16px; white-space: pre-wrap; line-height: 1.45; font-size: 14px; }
    .msg.bot .bubble { background: #fff; border: 1px solid #e2e8f0; color: #0f172a; }
    .msg.user .bubble { background: #1769E0; color: #fff; }
    .msg small { color: #94a3b8; font-size: 11px; margin-top: 3px; }
    .opts { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .chip { border: 1px solid #1769E0; background: #ebf3ff; color: #1769E0; border-radius: 999px; padding: 5px 12px; font-size: 12px; cursor: pointer; text-decoration: none; white-space: nowrap; }
    .chips { display: flex; gap: 8px; overflow-x: auto; padding: 8px 12px; border-top: 1px solid #e2e8f0; background: #fff; }
    .chat-input { display: flex; gap: 8px; padding: 10px 12px; border-top: 1px solid #e2e8f0; background: #fff; }
    .chat-input input { flex: 1; border: 1px solid #e2e8f0; border-radius: 999px; padding: 10px 16px; font-size: 14px; }
    .chat-input button { background: #1769E0; color: #fff; border: 0; border-radius: 999px; padding: 0 20px; font-weight: 600; }
</style>

<div class="chatbot">

    <div class="chatbot-header">
        <a asp-controller="Home" asp-action="Index" title="Back to Home Page">←</a>
        <div>
            <strong>Bridge &amp; Anchor Assistant</strong>
            <span>● Online | Customer Support</span>
        </div>
    </div>

    <div id="chatLog" class="chatbot-log" aria-live="polite"></div>

    <div class="chips">
        <button type="button" class="chip" data-q="How much can I borrow?">💰 Loan Info</button>
        <button type="button" class="chip" data-q="What documents do I need?">📄 Required Docs</button>
        <button type="button" class="chip" data-q="How do I apply?">📝 How to Apply</button>
        <button type="button" class="chip" data-q="Where are the branches?">🏢 Branches</button>
        <button type="button" class="chip" data-q="How can I contact Bridge and Anchor?">📞 Contact Support</button>
    </div>

    <form id="chatForm" class="chat-input">
        <input id="chatInput" type="text" maxlength="300" autocomplete="off" placeholder="Type a question or message..." />
        <button type="submit">Send</button>
    </form>

</div>

@section Scripts {
    <script>
        const askUrl = '@Url.Action("Ask", "Chatbot")';
        const log = document.getElementById('chatLog');
        const input = document.getElementById('chatInput');

        function now() {
            return new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        function addMessage(text, who, options) {
            const wrap = document.createElement('div');
            wrap.className = 'msg ' + who;

            const bubble = document.createElement('div');
            bubble.className = 'bubble';
            bubble.textContent = text;          // textContent, so replies can never inject HTML
            wrap.appendChild(bubble);

            if (options && options.length) {
                const row = document.createElement('div');
                row.className = 'opts';
                options.forEach(o => {
                    let el;
                    if (o.href) {
                        el = document.createElement('a');
                        el.href = o.href;
                    } else {
                        el = document.createElement('button');
                        el.type = 'button';
                        el.addEventListener('click', () => ask(o.query));
                    }
                    el.className = 'chip';
                    el.textContent = o.label;
                    row.appendChild(el);
                });
                wrap.appendChild(row);
            }

            const time = document.createElement('small');
            time.textContent = now();
            wrap.appendChild(time);

            log.appendChild(wrap);
            log.scrollTop = log.scrollHeight;
        }

        async function getReply(q) {
            try {
                const res = await fetch(askUrl + '?q=' + encodeURIComponent(q),
                                        { headers: { 'Accept': 'application/json' } });
                if (!res.ok) throw new Error('bad response');
                const data = await res.json();
                addMessage(data.text, 'bot', data.options);
            } catch {
                addMessage('Sorry, something went wrong. Please try again.', 'bot');
            }
        }

        function ask(q) {
            addMessage(q, 'user');
            getReply(q);
        }

        document.getElementById('chatForm').addEventListener('submit', e => {
            e.preventDefault();
            const text = input.value.trim();
            if (!text) return;
            input.value = '';
            ask(text);
        });

        document.querySelectorAll('.chips .chip').forEach(c =>
            c.addEventListener('click', () => ask(c.dataset.q)));

        getReply('hello');   // welcome message
    </script>
}