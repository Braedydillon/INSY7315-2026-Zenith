@model INSY7315_Prototype.ViewModels.RegisterViewModel

@{
    ViewData["Title"] = "Register";
}

<div class="auth-page">

    <div class="auth-card">

        <div class="auth-header">
            <h1>Create an Account</h1>
            <p>Get started with your loan application</p>
        </div>

        <form asp-controller="Account" asp-action="Register" method="post">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="FullName">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="Enter your full name" autocomplete="name" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <input asp-for="Email" class="form-control" placeholder="Enter your email address" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            @* <div class="form-group">
                <label asp-for="Phone">Phone Number</label>
                <input asp-for="Phone" class="form-control" placeholder="Enter your phone number" autocomplete="tel" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div> *@

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" class="form-control" placeholder="Create a password" autocomplete="new-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm your password" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="auth-button btn-shadow">
                Create Account
            </button>

        </form>

        <div class="auth-footer">
            <p>
                Already have an account?
                <a asp-controller="Account"
                   asp-action="Login">
                    Login
                </a>
            </p>
        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}