rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role()     { return request.auth.token.get('role', 'client'); }
    function isStaff()  { return role() in ['admin', 'management']; }

    // Loan applications: owners and staff can READ. All WRITES go through the API (Admin SDK bypasses rules).
    match /LoanApplications/{id} {
      allow read:  if signedIn() && (resource.data.UserId == request.auth.uid || isStaff());
      allow write: if false;
    }

    // User profiles: you can read your own; staff can read all. Writes only via the API.
    match /Users/{uid} {
      allow read:  if signedIn() && (request.auth.uid == uid || isStaff());
      allow write: if false;
    }

    // Everything else is locked down.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
